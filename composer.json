{
    "name": "laravelazier/laravelazier",
    "description": "Lightweight Laravel package for generating PDF and Excel files with minimal setup.",
    "keywords": ["laravel", "pdf", "excel", "xlsx", "export", "helpers", "blade"],
    "homepage": "https://github.com/laravelazier/laravelazier",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Laravelazier Contributors",
            "homepage": "https://github.com/laravelazier/laravelazier/contributors"
        }
    ],
    "support": {
        "issues": "https://github.com/laravelazier/laravelazier/issues",
        "source": "https://github.com/laravelazier/laravelazier"
    },
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "dompdf/dompdf": "^3.1.6",
        "phpoffice/phpspreadsheet": "^1.29|^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Laravelazier\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Laravelazier\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laravelazier\\LaravelazierServiceProvider"
            ],
            "aliases": {
                "Laz": "Laravelazier\\Facades\\Laz"
            }
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
